<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" spacing="16" styleClass="card">
    <HBox alignment="CENTER_LEFT" spacing="14">
        <Label text="Members" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="Search members..." prefWidth="280" styleClass="field"/>
    </HBox>

    <TableView fx:id="memberTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idCol" text="Member ID" prefWidth="100"/>
            <TableColumn fx:id="nameCol" text="Full Name" prefWidth="170"/>
            <TableColumn fx:id="emailCol" text="Email" prefWidth="200"/>
            <TableColumn fx:id="phoneCol" text="Phone" prefWidth="140"/>
            <TableColumn fx:id="addressCol" text="Address" prefWidth="150"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="EDIT SELECTED" onAction="#editMember" styleClass="primary-button"/>
        <Button text="DELETE SELECTED" onAction="#deleteMember" styleClass="secondary-button"/>
    </HBox>
</VBox>
